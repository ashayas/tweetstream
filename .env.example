# ==========================================
# tweet.stream Configuration (by Vartabase AI)
# ==========================================

# Server Settings
PORT=3000
HOST=0.0.0.0
BASE_URL=http://localhost:3000

# ------------------------------------------
# Option A: Zero-Key Hosted OAuth 2.0 (PKCE)
# Create your app at https://developer.x.com
# Set Type: Web App (confidential)
# Callback URL: http://localhost:3000/auth/callback (or https://tweet.stream/auth/callback)
# ------------------------------------------
X_CLIENT_ID=your_x_oauth2_client_id_here
X_CLIENT_SECRET=your_x_oauth2_client_secret_here
X_REDIRECT_URI=http://localhost:3000/auth/callback

# ------------------------------------------
# Option B: Bring Your Own Key (BYOK)
# Direct User Keys (OAuth 1.0a or User Access Token)
# ------------------------------------------
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Alternatively, if you already have an OAuth 2.0 User Bearer Token:
X_USER_ACCESS_TOKEN=

# ------------------------------------------
# Option C: tweet.stream Client Token
# (Issued when you authenticate via tweet.stream)
# ------------------------------------------
TWEET_STREAM_API_KEY=
